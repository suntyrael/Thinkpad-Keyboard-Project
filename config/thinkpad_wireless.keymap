#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/* Mic-mute key: HID Consumer usage 0xE9 is AC Volume Increment (Volume Up),
 * NOT mic mute - c709cec's assumption was wrong and the key produced
 * Volume Up on Windows. The spec-correct code is Generic Desktop page
 * 0xA9 (System Microphone Mute), but ZMK cannot emit GD page usages
 * (zmk_hid_press accepts KEY/CONSUMER only; upstream #1535) and Windows 11
 * has no built-in handling for 0xA9 anyway (Microsoft Learn HUTRR110 Q&A).
 * Consumer 0xD5 "Start or Stop Microphone Capture" is the semantic consumer
 * code and is ZMK-sendable; Windows currently ignores it (no misfire).
 * Teams/Zoom users can bind an app-shortcut macro instead (Ctrl+Shift+M /
 * Alt+A). */
#define C_MIC_MUTE (ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0xD5))

/ {
    combos {
        compatible = "zmk,combos";
        /* ZMK Studio unlock: Q + P + J pressed together (user-defined
         * unlock key, 2026-08-16). positions: Q=33, P=42, J=55. */
        combo_studio_unlock {
            timeout-ms = <150>;
            key-positions = <33 42 55>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12    &kp HOME   &kp END    &kp DEL
                &kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS  &kp EQUAL  &kp BSPC   &trans     &trans
                &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp LBKT   &kp RBKT   &kp BSLH   &kp K_CMENU &trans
                /* pos 46 = matrix (4,11): X220 menu key, bound 2026-08-17
                 * (K_CMENU = standard application key, HID usage 0x65) */
                &kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT    &kp RET    &trans     &trans     &trans
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT  &kp UP     &trans     &trans     &trans
                &kp LCTRL  &kp LWIN   &kp LALT   &trans     &trans     &kp SPACE  &trans     &trans     &kp RALT   &kp RCTRL  &kp LEFT   &kp DOWN   &kp RIGHT  &trans     &trans     &trans
                &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &kp C_MIC_MUTE &mo 1 &kp PG_UP &kp PG_DN  &kp C_AC_BACK &kp C_AC_FORWARD &kp PSCRN &kp SLCK &kp PAUSE_BREAK &trans &trans &trans &trans
                /* pos 100 = ThinkVantage key (matrix (5,10)): now activates
                 * the BT layer (mo 1) so ThinkVantage+1..5 switch BT devices
                 * and ThinkVantage+Power (2 s) pairs (2026-08-17); it no
                 * longer sends F13. */
                /* Row 7: pos 112 = Insert (matrix (0,9), bring-up verified
                 * 2026-08-17); remaining row-7 positions are unused. */
                &kp INS    &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                /* Row 8: HOTKEY = Fn (mo 2), PWRSWITCH = local power on/off
                 * only (long-press in board firmware); no HID C_PWR to the
                 * host (review 2.16).
                 *
                 * Pairing: ThinkVantage (layer 1) + Power held >= 2 s is
                 * handled by status_leds.c. */
                &mo 2      &none
            >;
        };

        bt_layer {
            bindings = <
                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &none /* Row 8 */
            >;
        };

        fn_layer {
            bindings = <
                /* Row 0: F2=Lock, F3=Battery/Power, F4=Sleep, F5=WiFi/BT Panel, F6=Camera, F7=Project, F8=TrackPoint toggle, F12=Hibernate, Home=Bri+, End=Bri- */
                &trans     &trans     &kp LG(L)  &kp LG(X)  &kp C_SLEEP &kp LG(A) &kp LC(LS(O)) &kp LG(P) &ext_power EP_TOG &trans &trans &trans &kp C_SLEEP_MODE &kp C_BRI_UP &kp C_BRI_DN &trans
                /* Row 1 */
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                /* Row 2 */
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                /* Row 3 */
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                /* Row 4: Up arrow = Stop */
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &kp C_STOP &trans     &trans     &trans
                /* Row 5: Space = Zoom in (Ctrl+=), Left = Next, Down = Play/Pause, Right = Prev */
                &trans     &trans     &trans     &trans     &trans     &kp LC(EQUAL) &trans  &trans     &trans     &trans     &kp C_NEXT &kp C_PP   &kp C_PREV &trans     &trans     &trans
                /* Row 6: pos 105 (PrtSc) = SysRq, pos 106 (ScrLk) = NumLock, pos 107 (Pause) = Break */
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &kp SYSREQ &kp KP_NUM &kp LC(PAUSE_BREAK) &trans &trans &trans &trans
                /* Row 7 */
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                /* Row 8 */
                &trans     &none
            >;
        };
    };
};